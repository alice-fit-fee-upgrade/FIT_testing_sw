set_property PACKAGE_PIN AA3 [get_ports MCLK1_P]
set_property PACKAGE_PIN AA2 [get_ports MCLK1_N]
set_property IOSTANDARD LVDS [get_ports {MCLK1_P MCLK1_N}]
set_property PACKAGE_PIN H6 [get_ports MGTCLK_P]
set_property PACKAGE_PIN H5 [get_ports MGTCLK_N]
set_property PACKAGE_PIN P2 [get_ports TX_P]
set_property PACKAGE_PIN P1 [get_ports TX_N]
set_property PACKAGE_PIN R4 [get_ports RX_P]
set_property PACKAGE_PIN R3 [get_ports RX_N]
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
create_clock -name sys -period 8.333333 [get_ports MCLK1_P]
create_clock -name mgt -period 5.000 [get_ports MGTCLK_P]
create_clock -name jtag -period 1000.0 [get_pins -hier -filter {REF_PIN_NAME == TCK && NAME =~ *read_scan*}]
set_clock_groups -asynchronous -group [get_clocks sys] -group [get_clocks mgt] -group [get_clocks jtag]
set_false_path -to [get_cells -hier -filter {ASYNC_REG == TRUE}]
create_clock -name gt_txout -period 16.000 [get_pins GTXE2_CHANNEL/TXOUTCLK]
create_clock -name gt_rxout -period 16.000 [get_pins GTXE2_CHANNEL/RXOUTCLK]
create_clock -name jtag_cmd -period 1000.0 [get_pins eth_jtag/cmd_scan/TCK]
set_clock_groups -asynchronous -group [get_clocks sys] -group [get_clocks mgt] -group [get_clocks -include_generated_clocks gt_txout] -group [get_clocks -include_generated_clocks gt_rxout] -group [get_clocks {jtag jtag_cmd}]
